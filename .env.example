# ========================================
# AI Dev Workspace — Environment Config
# Copy this to .env and fill in your values
# ========================================

# ----------------------------------------
# Default AI Provider
# Options: openai, ollama
# (For Groq/Azure, use openai with custom base_url)
# ----------------------------------------
AI_PROVIDER=openai
AI_BASE_URL=https://api.openai.com/v1
AI_API_KEY=
AI_MODEL=gpt-4o-mini

# ----------------------------------------
# Per-Role Provider Override (optional)
# If not set, uses default AI_* settings above
# ----------------------------------------
PLANNER_PROVIDER=
PLANNER_BASE_URL=
PLANNER_API_KEY=
PLANNER_MODEL=

REVIEWER_PROVIDER=
REVIEWER_BASE_URL=
REVIEWER_API_KEY=
REVIEWER_MODEL=

# ----------------------------------------
# Application Settings
# ----------------------------------------
APP_NAME=AI Dev Workspace
APP_VERSION=1.0.0
DEBUG=false

# Database (SQLite — local file, no server needed)
DATABASE_URL=sqlite+aiosqlite:///./ai_increed.db

# Workspace directory (where .md project files are saved)
WORKSPACE_DIR=../workspace

# Backend host/port
HOST=127.0.0.1
PORT=8000

# ========================================
# Example Configurations
# ========================================
#
# OpenAI:
#   AI_PROVIDER=openai
#   AI_BASE_URL=https://api.openai.com/v1
#   AI_API_KEY=sk-...
#   AI_MODEL=gpt-4o-mini
#
# Groq:
#   AI_PROVIDER=openai
#   AI_BASE_URL=https://api.groq.com/openai/v1
#   AI_API_KEY=gsk_...
#   AI_MODEL=llama-3.1-70b-versatile
#
# Azure OpenAI:
#   AI_PROVIDER=openai
#   AI_BASE_URL=https://YOUR_RESOURCE.openai.azure.com/openai/deployments/YOUR_DEPLOYMENT
#   AI_API_KEY=...
#   AI_MODEL=gpt-4o
#
# Ollama (local, no API key needed):
#   AI_PROVIDER=ollama
#   AI_BASE_URL=http://localhost:11434/v1
#   AI_MODEL=llama3.2
