# AI_Increed Backend — Environment Configuration
# Copy this file to .env and fill in your values.
# ⚠️  NEVER commit .env to version control — it contains API keys.

# ── Application ──────────────────────────────────────────────────────────────
APP_NAME=AI_Increed
VERSION=0.1.0
DEBUG=false

# ── Database ─────────────────────────────────────────────────────────────────
DATABASE_URL=sqlite+aiosqlite:///./ai_increed.db

# ── Workspace ─────────────────────────────────────────────────────────────────
WORKSPACE_DIR=../workspace

# ── Global / Fallback AI Provider ─────────────────────────────────────────────
# Used when role-specific provider is not set.
AI_PROVIDER=openai
AI_BASE_URL=https://api.openai.com/v1
AI_API_KEY=sk-your-api-key-here
AI_MODEL=gpt-4o-mini

# ── Planner Role ──────────────────────────────────────────────────────────────
# Leave empty to fall back to global settings above.
PLANNER_PROVIDER=
PLANNER_BASE_URL=
PLANNER_API_KEY=
PLANNER_MODEL=

# ── Reviewer Role ─────────────────────────────────────────────────────────────
REVIEWER_PROVIDER=
REVIEWER_BASE_URL=
REVIEWER_API_KEY=
REVIEWER_MODEL=

# ── Ollama (local) ────────────────────────────────────────────────────────────
# Set AI_PROVIDER=ollama (or PLANNER_PROVIDER=ollama) to use Ollama.
OLLAMA_BASE_URL=http://localhost:11434/v1

# ── CORS ──────────────────────────────────────────────────────────────────────
# JSON list of allowed origins
# CORS_ORIGINS=["http://localhost:3000","http://localhost:5173"]

# ── Example: Groq ─────────────────────────────────────────────────────────────
# AI_PROVIDER=groq
# AI_BASE_URL=https://api.groq.com/openai/v1
# AI_API_KEY=gsk_your-groq-key
# AI_MODEL=llama-3.1-8b-instant

# ── Example: Azure OpenAI ─────────────────────────────────────────────────────
# AI_PROVIDER=azure
# AI_BASE_URL=https://your-resource.openai.azure.com/openai/deployments/your-deployment
# AI_API_KEY=your-azure-key
# AI_MODEL=gpt-4o
